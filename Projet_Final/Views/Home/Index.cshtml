@{
	ViewData["Title"] = "Accueil";
}
@{
	ViewData["Title"] = "Accueil - Harmonie Gourmande";
}
@model List<Recette>

<div class="home-hero">
	<h1>Bienvenue chez Harmonie Gourmande</h1>
	<p>Découvrez nos recettes gourmandes et partagez les vôtres !</p>
</div>

<h2>Nos dernières recettes</h2>

@if (Model == null || !Model.Any())
{
	<div class="no-recipes">
		<p>Aucune recette n'a encore été partagée... Soyez le premier ! 🍫🥧</p>
	</div>
}
else
{
	<div class="recipes-grid">
		@foreach (var recette in Model)
		{
			<a asp-controller="Recette"
			   asp-action="AfficherDetailRecette"
			   asp-route-id="@recette.ID"
			   class="recipe-card-link">

				<div class="recipe-card">
					<div class="image"
						 style="background-image: url('@(string.IsNullOrWhiteSpace(recette.UrlImage)
															 	 ? "https://images.unsplash.com/photo-1606318801954-d46d46d3360a?w=600"
																		 	 : recette.UrlImage)');">
			</div>
			<div class="description">
				<h3>@recette.TitreRecette</h3>
				<small>Cœur coulant irrésistible – par @recette.AuteurRecette</small>
				<!-- Variante plus réaliste : -->
				<!-- <small>@recette.Description?.Substring(0, Math.Min(60, recette.Description?.Length ?? 0))...</small> -->
			</div>
		</div>
	</a>
		}
	</div>

	<!-- Optionnel : lien vers toutes les recettes -->
	<div class="see-more">
		<a asp-controller="Recette" asp-action="Index" class="btn-see-more">
			Voir toutes les recettes →
		</a>
	</div>
}

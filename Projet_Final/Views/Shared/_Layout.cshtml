<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Harmonie Gourmande - @ViewData["Title"]</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.jpg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lavishly+Yours&family=Pacifico&family=Parisienne&display=swap"
          rel="stylesheet">
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/style.css">
</head>

<body>
    <header>
        <div class="top-header">
            <div class="logo">
                <a href="/">
                    <img src="~/images/logo.jpg" alt="Logo Harmonie Gourmande">
                </a>
            </div>
            <div class="site-title">
                <h1>Harmonie Gourmande</h1>
            </div>
        </div>
    </header>

    <nav>
        <a href="/" class="active">Accueil</a>
        <a href="/AjouterRecette">Créer Recette</a>
        <a href="ingredients.html">Liste des ingrédients</a>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="contact">
            <span>Pour nous contacter :</span><br>
            <span>- Email : contact@harmoniegourmande.fr</span><br>
            <span>- Téléphone : 01 02 03 04 05</span><br>
            <p>Tous droits réservés Copyright © 2026 - harmoniegourmande.com</p>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

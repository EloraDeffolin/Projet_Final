@model RecetteDetailDTO

<div class="recipe-title">
    @if (Model?.Recette != null)
    {
        <h1 class="title-recette">@Model.Recette.TitreRecette</h1>
        <p><strong>Créé par :</strong> @(Model.Recette.AuteurRecette ?? "Anonyme")</p>
    }
    else
    {
        <h1>Recette non trouvée</h1>
        <p>L'identifiant fourni n'existe pas ou la recette a été supprimée.</p>
    }
</div>

<div class="recipe-img">
    @if (Model?.Recette != null && !string.IsNullOrWhiteSpace(Model.Recette.UrlImage))
    {
        <img src="@Model.Recette.UrlImage" class="main-image" alt="@(Model.Recette.TitreRecette ?? "Recette")" />
    }
    else
    {
        <div class="placeholder">Aucune image disponible</div>
    }
</div>

@if (Model?.Recette != null)
{
    <h3>Description :</h3>
    <p>@(Model.Recette.Description ?? "Aucune description")</p>

    <h3>Instructions :</h3>
    <p>@(Model.Recette.Instruction ?? "Aucune instruction disponible")</p>

    <h3>Ingrédients :</h3>
    <p>
      
        @if (Model.Ingredients != null && Model.Ingredients.Any())
        {
            <ul>
                @foreach (IngredientsDTO item in Model.Ingredients)
                {
                    <li>
                        @item.Ingredient?.NomIngredient
                        - @item.Quantite
                        @item.TypeQuantite
                    </li>
                }
            </ul>
        }
        else
        {
        <p>Aucun ingrédient pour cette recette.</p>
    }
    </p>
}
@model RecetteDetailDTO
        <div class="recipe-detail">
            <div class="recipe-content">
                <div class="recipe-header">
                    <div class="recipe-title">
                        <h1>@Model.Recette.TitreRecette</h1>
                        <p><strong>Créé par :</strong> @Model.Recette.AuteurRecette</p>
                    </div>
                    <div class="actions">
                        <button class="edit-btn"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button class="delete-btn"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                </div>
                <div class="recipe-img">
                    <div class="main-image">
                        <img src=@Model.Recette.UrlImage
                             alt="Fondant au chocolat cœur coulant">
                    </div>
                    <div class="info">
                        <h3>Liste des Ingrédients :</h3>
                        <ul>
                            @foreach(IngredientsDTO ingredients in Model.Ingredients){
                            <li>@ingredients.Quantite @ingredients.TypeQuantite de @ingredients.Ingredient.NomIngredient</li>}
                          
                        </ul>
                    </div>
                </div>
            </div>
            <h3>Description :</h3>
            <p>
                @Model.Recette.Description
            </p>
            <h3>Instructions:</h3>
            <p>
                @Model.Recette.Instruction
            </p>
        </div>

        <h2>Ajouter une Recette</h2>

        <form>
            <div class="form-group">
                <label for="titre">Titre :</label>
                <input type="text" id="titre" placeholder="Ex: Gâteau Merveilleux ..." required>
            </div>

            <div class="form-group">
                <label for="description">Description :</label>
                <textarea id="description" rows="4" placeholder="Ex: Mélanger les ingrédients ..." required></textarea>
            </div>

            <div class="form-group">
                <label for="url-image">URL de l'image :</label>
                <input type="url" id="url-image" placeholder="https://..." required>
            </div>

            <div class="form-group">
                <label for="instructions">Instructions :</label>
                <textarea id="instructions" rows="6" placeholder="Ex: ajouter les ingrédients ..." required></textarea>
            </div>

            <div class="form-group">
                <label>Auteur :</label>
                <input type="text" placeholder="Nom de l'auteur, ex: Jane Doe" required>
            </div>

            <div class="form-group">
                <label>Ingrédients (nom + quantité) :</label>
                <div class="ingredient-row">
                    <input type="text" placeholder="Ex: Chocolat noir" required>
                    <input type="text" class="quantity" placeholder="200g" required>
                </div>
                <div class="ingredient-row">
                    <input type="text" placeholder="Ex: Œufs" required>
                    <input type="text" class="quantity" placeholder="3" required>
                </div>
            </div>
            <button type="submit">Créer la recette</button>
        </form>
@model RecetteDetailDTO

<div class="container">
    <h2>Ajouter une Recette</h2>

    <form asp-controller="Recette" asp-action="AjouterRecette" method="post">
        <div class="form-group">
            <label asp-for="Recette.TitreRecette">Titre :</label>
            <input asp-for="Recette.TitreRecette" type="text" id="titre" placeholder="Ex: Gâteau Merveilleux ..." required>
        </div>

        <div class="form-group">
            <label asp-for="Recette.Description">Description :</label>
            <textarea asp-for="Recette.Description" id="description" rows="4" placeholder="Ex: Mélanger les ingrédients ..." required></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Recette.UrlImage">URL de l'image :</label>
            <input asp-for="Recette.UrlImage" type="url" id="url-image" placeholder="https://..." required>
        </div>

        <div class="form-group">
            <label asp-for="Recette.Instruction">Instructions :</label>
            <textarea asp-for ="Recette.Instruction" id="instructions" rows="6" placeholder="Ex: ajouter les ingrédients ..." required></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Recette.AuteurRecette">Auteur :</label>
            <input asp-for="Recette.AuteurRecette" type="text" placeholder="Nom de l'auteur, ex: Jane Doe" required>
        </div>

        <div class="form-group">
            <label>Ingrédients (nom + quantité) :</label>
            <div class="ingredient-row">
                <select asp-for="Ingredients[0].Id">
                    @foreach (IngredientsDTO ingredientDTO in Model.Ingredients)
                    {
                        <option value=@ingredientDTO.Ingredient.Id>@ingredientDTO.Ingredient.NomIngredient</option>
                    }
                </select>                
                <input asp-for="Ingredients[0].Quantite" type="text" class="quantity" placeholder="200g" required>
                <select asp-for="Ingredients[0].TypeQuantite">
                    @foreach (TypeQuantite categorie in Enum.GetValues(typeof(TypeQuantite)))
                    {
                        <option value=@categorie>@categorie</option>
                    }
                </select>
            </div>
            
        </div>
        <button type="submit">Créer la recette</button>
    </form>
</div>

<div asp-validation-summary="All"></div>

@model List<Ingredient>

<h2>Liste des Ingrédients</h2>
<table>
	<thead>
		<tr>
			<th>Id</th>
			<th>Nom</th>
			<th>Catégorie</th>
			<th>Action</th>
		</tr>
	</thead>
	<tbody>
		@foreach (Ingredient ingredient in Model)
		{
			<tr>
				<td>@ingredient.Id</td>
				<td>@ingredient.NomIngredient</td>
				<td>@ingredient.Categorie</td>
				<td><a type="button" asp-controller="Ingredient" asp-action="SupprimerIngredient" asp-route-id="@ingredient.Id" class="delete-btn">×</a></td>
			</tr>

		}
	</tbody>
</table>
<div class="btn-actions">
	<a asp-controller="Ingredient" asp-action="AjouterIngredient" class="add-btn">Ajouter un produit</a>
</div>
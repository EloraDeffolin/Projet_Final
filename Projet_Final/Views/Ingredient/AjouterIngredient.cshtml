@model Ingredient
        <h2>Ajout d'un Ingrédient</h2>

<form asp-action="AjouterIngredient" method="post">
    <div class="form-group">
        <label>Nom Ingredient :</label>
        <input asp-for="NomIngredient" />
    </div>
    <div class="form-group">
        <label>Categorie :</label>
        <select asp-for="Categorie">
            @foreach(CategorieEnum categorie in Enum.GetValues (typeof(CategorieEnum)))
            {
                <option value=@categorie>@categorie</option>
            }
        </select>
    </div>
    <button type="submit">Ajouter</button>
</form>

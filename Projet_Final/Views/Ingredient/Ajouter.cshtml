
        <h2>Ajout d'un Ingrédient</h2>

        <form>
            <div class="form-group">
                <label for="nom">Nom</label>
                <input type="text" id="nom" placeholder="ex: Courgette, Poulet, Beurre ..." required>
            </div>

            <div class="form-group">
                <label for="categorie">Catégorie</label>
                <input type="text" id="categorie" placeholder="ex: Légume, Viande, Produit laitier ..." required>
            </div>

            <button type="submit">Ajouter</button>
        </form>
